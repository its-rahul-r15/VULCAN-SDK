{
  "name": "@its_rahul_r15/vulcan-sdk",
  "version": "1.0.0",
  "description": "Production-grade AI Agent SDK — multi-provider, typed, observable, and framework-free.",
  "keywords": [
    "ai",
    "agent",
    "sdk",
    "openai",
    "anthropic",
    "gemini",
    "llm",
    "typescript",
    "tool-calling",
    "multi-agent"
  ],
  "author": "Rahul Sharma",
  "license": "MIT",
  "homepage": "https://github.com/its-rahul-r15/VULCAN-SDK#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/its-rahul-r15/VULCAN-SDK.git"
  },
  "bugs": {
    "url": "https://github.com/its-rahul-r15/VULCAN-SDK/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "dev": "ts-node --esm src/index.ts",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"examples/**/*.ts\"",
    "prepublishOnly": "npm run build && npm run type-check",
    "example:basic": "ts-node --esm examples/basic-agent.ts",
    "example:handoff": "ts-node --esm examples/multi-agent-handoff.ts",
    "example:guardrails": "ts-node --esm examples/guardrails.ts",
    "example:structured": "ts-node --esm examples/structured-output.ts",
    "example:streaming": "ts-node --esm examples/streaming.ts",
    "publish-check": "node scripts/publish-check.js"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": "^0.20.0",
    "@google/generative-ai": "^0.3.0",
    "openai": "^4.0.0"
  },
  "peerDependenciesOptional": {
    "@anthropic-ai/sdk": true,
    "@google/generative-ai": true
  },
  "optionalDependencies": {
    "better-sqlite3": "^9.0.0"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "uuid": "^9.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@google/generative-ai": "^0.24.1",
    "@types/better-sqlite3": "^7.6.8",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.11.0",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "openai": "^4.28.0",
    "prettier": "^3.2.4",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "tsup": "^8.0.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
