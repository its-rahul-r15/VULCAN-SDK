# OpenAI Provider
OPENAI_API_KEY=sk-...

# Anthropic Provider (optional)
ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini Provider (optional)
GEMINI_API_KEY=AIza...

# Default model (optional, defaults to gpt-4o)
VULCAN_DEFAULT_MODEL=gpt-4o

# SQLite storage path (optional, defaults to in-memory)
VULCAN_SQLITE_PATH=./vulcan-sessions.db

# Logging level: debug | info | warn | error (default: info)
VULCAN_LOG_LEVEL=info

# Max retries on provider errors (default: 3)
VULCAN_MAX_RETRIES=3
